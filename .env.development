# Dev: leave VITE_API_URL unset to use the same-origin Vite proxy (see vite.config.ts).
# Set it only when pointing at a non-proxied API origin.
# VITE_API_URL=http://localhost:8000/api/v1
#
# Where the proxy sends /api and /uploads. Local backend by default; point it
# at the hosted one to develop against real data (cookies are rewritten so they
# stay first-party on localhost).
# VITE_PROXY_TARGET=http://localhost:8000

# ─── The two surfaces ────────────────────────────────────────────────────────
# One repo, one Vercel project, two hostnames attached to it. Both names get
# the SAME build, so the split is decided at runtime by comparing the browser's
# origin against these two values (src/app/surface.ts).
#
#   VITE_SITE_ORIGIN   the public site. Also feeds SeoHead's canonical/og:url.
#   VITE_STAFF_ORIGIN  the app: login, dashboard, patients, prescriptions.
#
# Set BOTH on the single Vercel project, for every environment you deploy.
# If VITE_STAFF_ORIGIN is unset or does not match, every hostname falls back to
# the public surface — it fails closed, so a misconfiguration hides the app
# rather than exposing it.
#
# Leave both unset in local dev: everything serves the public surface and
# `?surface=staff` switches the tab to the app on the same origin.
#
# Keep VITE_STAFF_ORIGIN's hostname in step with the `has.host` value in
# vercel.json, which stamps X-Robots-Tag: noindex on the app hostname. That
# file is strict JSON with no comment syntax, so the note lives here.
# VITE_SITE_ORIGIN=https://ortho-fe.foxquart.com
# VITE_STAFF_ORIGIN=https://ortho-dash.foxquart.com

# Google Places API (New) — used ONLY by scripts/fetch-google-reviews.ts at
# build time to bake real reviews into the landing page. Server/build only:
# never prefix these with VITE_ — anything VITE_* is shipped to the browser.
#   GOOGLE_PLACES_API_KEY: Google Cloud key with "Places API (New)" enabled,
#     restricted to that API (console.cloud.google.com → APIs & Services).
#   GOOGLE_PLACE_ID: from the Place ID finder
#     (https://developers.google.com/maps/documentation/javascript/examples/places-placeid-finder),
#     search "Dr. Shanker Debroy Battala Agartala".
# Leave unset: the fetch is a no-op and the landing renders the hand-written
# fallback reviews from src/features/landing/profile.ts.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=


# Hosted backend, reached through the dev-server proxy rather than directly.
# Direct `VITE_API_URL` cannot work from localhost: the API scopes its cookies
# to `Domain=.foxquart.com`, so the browser discards them. Proxying keeps the
# session cookie first-party on localhost (see vite.config.ts).
VITE_PROXY_TARGET=https://clinic-api.foxquart.com

# Locally the staff surface IS localhost, so `bun run dev` opens the app
# (login -> dashboard) instead of the public landing page.
VITE_STAFF_ORIGIN=http://localhost:5173
