# Dev: leave VITE_API_URL unset to use the same-origin Vite proxy (see vite.config.ts).
# Set it only when pointing at a non-proxied API origin.
# VITE_API_URL=http://localhost:8000/api/v1
VITE_PROXY_TARGET=http://localhost:8000

# Public origin of the marketing site, e.g. https://drsankardebroy.com
# Unset until the domain is bought: SeoHead.tsx skips canonical and og:url
# rather than emit ones pointing at the wrong origin.
# VITE_SITE_ORIGIN=
